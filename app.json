{
  "expo": {
    "name": "Vride",
    "slug": "rideflow-mobility",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FBF5F4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aistudio.rideflow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF5F4"
      },
      "package": "com.aistudio.rideflow.kxmpzq"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
